# Initialize-Lab.ps1 creates .env with fresh passwords. This example is not a secret.
STACK_VERSION=9.5.5
SPLUNK_VERSION=10.4.0
# LAB_SERVER_IP: private address Windows VM uses, also included in TLS certificate SANs.
# DATA_BIND_IP: address on the Docker host that owns the published port binding.
# Native Docker in WSL NAT: these differ; see docs/setup/02-network.md.
# Set before first Elastic startup. DATA_BIND_IP=localhost is offline-only.
LAB_SERVER_IP=192.168.56.10
DATA_BIND_IP=127.0.0.1
ELASTIC_PASSWORD=GENERATE_WITH_INITIALIZER
KIBANA_PASSWORD=GENERATE_WITH_INITIALIZER
KIBANA_ENCRYPTION_KEY=GENERATE_WITH_INITIALIZER
SPLUNK_PASSWORD=GENERATE_WITH_INITIALIZER
FLEET_SERVER_SERVICE_TOKEN=
FLEET_SERVER_POLICY_ID=
